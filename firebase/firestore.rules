rules_version = '2';

// My Space - Firestore security rules
// Everyone signs in with Firebase Anonymous Auth. request.auth != null = a real install.
// Nothing is public. Media lives in Firestore (no paid Storage bucket).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, maxLen) { return v is string && v.size() <= maxLen; }
    function httpsOrEmpty(v) {
      return v is string && v.size() <= 2048
        && (v == '' || v.matches('^blob:[A-Za-z0-9]{10,40}$') || v.matches('^https://.*'));
    }
    // The password proof written in the same batch (SHA-256 checked, see /clearAuth).
    function proofOk(proofId) {
      return getAfter(/databases/$(database)/documents/clearAuth/$(proofId)).data.by == request.auth.uid
          && getAfter(/databases/$(database)/documents/clearAuth/$(proofId)).data.at == request.time;
    }
    // True if the CURRENT user is a verified admin (flag set only via password, below).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }
    function roomData(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
    function isRoomMember(roomId) {
      return roomId == 'main'
        || (exists(/databases/$(database)/documents/rooms/$(roomId))
            && request.auth.uid in roomData(roomId).members)
        || isAdmin();
    }

    // ---------- users/{uid} : profile, short id, presence, admin flag ----------
    match /users/{uid} {
      // Profiles are readable by any signed-in user (needed for avatars and ID lookup).
      allow read: if signedIn();

      // Normal profile write (name + photo), plus optional presence/shortId fields.
      allow create, update: if isMe(uid)
        && request.resource.data.diff(resource.data == null ? {} : resource.data).affectedKeys()
             .hasOnly(['name', 'photoUrl', 'updatedAt', 'shortId', 'lastSeen', 'device', 'admin', 'adminProof'])
        && (!('name' in request.resource.data) || (str(request.resource.data.name, 40) && request.resource.data.name.size() > 0))
        && (!('photoUrl' in request.resource.data) || httpsOrEmpty(request.resource.data.photoUrl))
        && (!('shortId' in request.resource.data) || str(request.resource.data.shortId, 12))
        && (!('device' in request.resource.data) || str(request.resource.data.device, 80))
        // The admin flag can only turn true together with a valid password proof in the same batch.
        && (
          !('admin' in request.resource.data.diff(resource.data == null ? {} : resource.data).affectedKeys())
          || (request.resource.data.admin == true
              && 'adminProof' in request.resource.data
              && proofOk(request.resource.data.adminProof))
        );
      allow delete: if isMe(uid);
    }

    // ---------- shortIds/{id} : public directory (reserve once, never steal) ----------
    match /shortIds/{shortId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false; // an id, once taken, is permanent
    }

    // ---------- rooms ----------
    match /rooms/{roomId} {
      // Members (and admins) read a room; the shared lobby "main" is readable by all.
      allow read: if isRoomMember(roomId);

      // Create/lastActivity/theme on a private room by one of its two members.
      allow create: if signedIn() && roomId != 'main'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && roomId != 'main' && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivity', 'theme', 'members']);
      allow delete: if false;

      // ---------- chat messages ----------
      match /chat/{messageId} {
        allow read: if isRoomMember(roomId);

        allow create: if isRoomMember(roomId)
          && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'senderPhoto', 'type', 'text',
                                                   'mediaUrl', 'mediaPath', 'refId', 'durationMs', 'timestamp',
                                                   'replyToId', 'replyToName', 'replyToText'])
          && request.resource.data.keys().hasAll(['senderUid', 'senderName', 'senderPhoto', 'type', 'timestamp'])
          && request.resource.data.senderUid == request.auth.uid
          && str(request.resource.data.senderName, 40) && request.resource.data.senderName.size() > 0
          && httpsOrEmpty(request.resource.data.senderPhoto)
          && request.resource.data.type in ['text', 'image', 'voice', 'sticker', 'music']
          && str(request.resource.data.get('text', ''), 4000)
          && httpsOrEmpty(request.resource.data.get('mediaUrl', ''))
          && str(request.resource.data.get('mediaPath', ''), 300)
          && str(request.resource.data.get('refId', ''), 100)
          && request.resource.data.get('durationMs', 0) is int
          && str(request.resource.data.get('replyToId', ''), 100)
          && str(request.resource.data.get('replyToName', ''), 40)
          && str(request.resource.data.get('replyToText', ''), 200)
          && request.resource.data.timestamp == request.time
          && (request.resource.data.type != 'text' || request.resource.data.get('text', '').size() > 0)
          && (request.resource.data.type == 'text' || request.resource.data.get('mediaUrl', '') != '');

        allow update: if isRoomMember(roomId) && (
          (resource.data.senderUid == request.auth.uid
            && resource.data.type != 'deleted'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['type', 'text', 'mediaUrl', 'replyToText', 'reactions'])
            && request.resource.data.type == 'deleted'
            && request.resource.data.text == ''
            && request.resource.data.mediaUrl == ''
            && request.resource.data.get('replyToText', '') == ''
            && request.resource.data.get('reactions', {}).size() == 0)
          ||
          (resource.data.type != 'deleted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || str(request.resource.data.reactions[request.auth.uid], 16)))
        );
        allow delete: if signedIn() && resource.data.senderUid == request.auth.uid;
      }

      // ---------- songs (anyone in the room can add or remove; default song has no doc) ----------
      match /music/{songId} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.resource.data.keys().hasOnly(['title', 'url', 'storagePath', 'uploaderUid', 'sizeBytes', 'createdAt'])
          && request.resource.data.uploaderUid == request.auth.uid
          && str(request.resource.data.title, 200) && request.resource.data.title.size() > 0
          && httpsOrEmpty(request.resource.data.url) && request.resource.data.url != ''
          && str(request.resource.data.storagePath, 300)
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes <= 15 * 1024 * 1024
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isRoomMember(roomId); // any member can tidy the playlist
      }

      // ---------- shared playback + clear-chat marker ----------
      match /state/{docId} {
        allow read: if isRoomMember(roomId);

        // Clear chat for everyone: needs the admin password proof in the same batch.
        allow create, update: if isRoomMember(roomId) && docId == 'chat'
          && request.resource.data.keys().hasOnly(['clearedAt', 'clearedBy', 'proof'])
          && request.resource.data.clearedAt == request.time
          && request.resource.data.clearedBy == request.auth.uid
          && str(request.resource.data.proof, 64)
          && proofOk(request.resource.data.proof);

        // Shared music state: any member may play/pause/seek for the room.
        allow create, update: if isRoomMember(roomId) && docId == 'player'
          && request.resource.data.keys().hasOnly(['songId', 'songTitle', 'songUrl', 'playing', 'positionMs', 'updatedAt', 'updatedBy'])
          && str(request.resource.data.songId, 100)
          && str(request.resource.data.songTitle, 200)
          && httpsOrEmpty(request.resource.data.songUrl)
          && request.resource.data.playing is bool
          && request.resource.data.positionMs is int && request.resource.data.positionMs >= 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // ---------- WebRTC signaling ----------
    match /calls/{callId} {
      function participant() {
        return request.auth.uid == resource.data.callerUid
            || (resource.data.calleeUid != '' && request.auth.uid == resource.data.calleeUid);
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['callerUid', 'callerName', 'callerPhoto', 'video', 'state',
                                                 'offer', 'answer', 'calleeUid', 'calleeName', 'createdAt'])
        && request.resource.data.callerUid == request.auth.uid
        && str(request.resource.data.callerName, 40)
        && httpsOrEmpty(request.resource.data.callerPhoto)
        && request.resource.data.video is bool
        && request.resource.data.state == 'ringing'
        && request.resource.data.offer is map
        && request.resource.data.offer.type == 'offer'
        && str(request.resource.data.offer.sdp, 100000)
        && request.resource.data.answer == null
        && request.resource.data.calleeUid == ''
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (resource.data.state == 'ringing'
          && request.auth.uid != resource.data.callerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'state', 'calleeUid', 'calleeName'])
          && request.resource.data.state == 'accepted'
          && request.resource.data.calleeUid == request.auth.uid
          && str(request.resource.data.calleeName, 40)
          && request.resource.data.answer is map
          && request.resource.data.answer.type == 'answer'
          && str(request.resource.data.answer.sdp, 100000))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
          && request.resource.data.state in ['rejected', 'ended']
          && (participant() || (resource.data.state == 'ringing' && request.resource.data.state == 'rejected')))
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.callerUid;

      match /candidates/{candidateId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/calls/$(callId))
          && request.resource.data.keys().hasOnly(['fromUid', 'sdp', 'sdpMid', 'sdpMLineIndex'])
          && request.resource.data.fromUid == request.auth.uid
          && str(request.resource.data.sdp, 2000)
          && str(request.resource.data.sdpMid, 64)
          && request.resource.data.sdpMLineIndex is int;
        allow update: if false;
        allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
      }
    }

    // ---------- media blobs (images, stickers, voice, music, profile photos) ----------
    match /blobs/{blobId} {
      function blobMeta() { return get(/databases/$(database)/documents/blobs/$(blobId)).data; }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'kind', 'mime', 'size', 'chunks', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind in ['profile', 'images', 'stickers', 'voice', 'music']
        && str(request.resource.data.mime, 100)
        && request.resource.data.size is int && request.resource.data.size > 0
        && ((request.resource.data.kind == 'music' && request.resource.data.size <= 15 * 1024 * 1024)
            || (request.resource.data.kind != 'music' && request.resource.data.size <= 5 * 1024 * 1024))
        && request.resource.data.chunks is int
        && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 20
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && blobMeta().ownerUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['i', 'data'])
          && request.resource.data.i is int
          && request.resource.data.i >= 0 && request.resource.data.i < blobMeta().chunks
          && chunkId == string(request.resource.data.i)
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900000;
        allow update: if false;
        allow delete: if signedIn() && blobMeta().ownerUid == request.auth.uid;
      }
    }

    // ---------- admin / clear-chat password proof ----------
    // Only the SHA-256 of the password lives here (in this rules file). The password itself
    // is never in the app. These docs are write-only; nobody can read them back.
    match /clearAuth/{proofId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['key', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.key is string && request.resource.data.key.size() <= 100
        && hashing.sha256(request.resource.data.key).toHexString().lower() == '525e48565d00d12b537037ebbe0d8b7f6718e9d5b67172e9c913aea3b6c43a13';
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
